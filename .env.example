# Copy this file to .env.local for local development and fill in your own values.
# On Netlify these are asked for during the one-click deploy. Never commit real values.

# Claude API key from console.anthropic.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Apify API token from console.apify.com (Settings > API & Integrations)
APIFY_TOKEN=

# Password for the /admin page. Use 12 or more characters.
ADMIN_PASSWORD=

# Optional: override the Claude model (default claude-sonnet-5-5)
# AI_MODEL=
